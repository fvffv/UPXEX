<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>UPX GUI</AssemblyName>
    <RootNamespace>UpxGui</RootNamespace>
    <OptimizationPreference>size</OptimizationPreference>
    <PublishAot>true</PublishAot>
    <SelfContained Condition="'$(SelfContained)' == ''">true</SelfContained>
    <PublishSingleFile Condition="'$(PublishAot)' == 'true'">true</PublishSingleFile>
    <StripSymbols Condition="'$(PublishAot)' == 'true'">true</StripSymbols>
    <InvariantGlobalization Condition="'$(PublishAot)' == 'true'">true</InvariantGlobalization>
    <!-- Override these two properties when publishing for a non-Windows host. -->
    <UpxExecutableSource Condition="'$(UpxExecutableSource)' == ''">..\build-nextgenmisa77\upx.exe</UpxExecutableSource>
    <UpxExecutableName Condition="'$(UpxExecutableName)' == ''">upx.exe</UpxExecutableName>
    <IncludeBundledUpx Condition="'$(IncludeBundledUpx)' == ''">true</IncludeBundledUpx>
  </PropertyGroup>

  <ItemGroup Condition="'$(IncludeBundledUpx)' == 'true'">
    <None Include="$(UpxExecutableSource)" Link="$(UpxExecutableName)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="StaticLink.Avalonia" Version="4.150.1-7922.1" />
    <PackageReference Include="StaticLink.Avalonia.Native" Version="12.1.1.1" />
  </ItemGroup>
</Project>
